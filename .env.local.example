# Copy this file to .env.local at the repository root.
# Paste your real Neon PostgreSQL connection string below.
# Do not commit the populated .env.local file.
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

ANALYSIS_BASE_URL=http://localhost:8001

# With DATABASE_URL configured, analysis API startup checks which official
# public sources are due and checks again while the analysis service runs.
# Does not automatically crawl permission-gated marketplaces.
FIN_ENGINE_AUTO_REFRESH=true
FIN_ENGINE_REFRESH_CHECK_HOURS=12
