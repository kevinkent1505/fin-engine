{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riil published market snapshot inbound v1 (allowlisted)",
  "description": "Schema for public financial-market-only handoff from Riil. Not Riil tracker, calculations, accounts or CMS. Additional fields are deliberately not ingested.",
  "type": "object",
  "required": [
    "updated_at",
    "indicators"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "indicators": {
      "type": "object",
      "required": [
        "usd_idr",
        "inflation_yoy",
        "oil_icp",
        "ihsg",
        "gold_antam",
        "fuel"
      ],
      "properties": {
        "usd_idr": {
          "$ref": "#/$defs/number"
        },
        "inflation_yoy": {
          "$ref": "#/$defs/number"
        },
        "oil_icp": {
          "$ref": "#/$defs/number"
        },
        "ihsg": {
          "$ref": "#/$defs/number"
        },
        "gold_antam": {
          "$ref": "#/$defs/gold"
        },
        "fuel": {
          "$ref": "#/$defs/fuel"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "as_of",
        "source_name",
        "source_url"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "number": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "gold": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "price",
            "buyback"
          ],
          "properties": {
            "unit": {
              "const": "IDR per gram"
            },
            "price": {
              "type": "number"
            },
            "buyback": {
              "type": "number"
            }
          }
        }
      ]
    },
    "fuel": {
      "allOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "object",
          "required": [
            "unit",
            "prices"
          ],
          "properties": {
            "unit": {
              "const": "IDR per litre"
            },
            "prices": {
              "type": "object",
              "required": [
                "pertalite",
                "pertamax",
                "pertamax_green",
                "pertamax_turbo",
                "dexlite",
                "pertamina_dex"
              ],
              "properties": {
                "pertalite": {
                  "type": "number"
                },
                "pertamax": {
                  "type": "number"
                },
                "pertamax_green": {
                  "type": "number"
                },
                "pertamax_turbo": {
                  "type": "number"
                },
                "dexlite": {
                  "type": "number"
                },
                "pertamina_dex": {
                  "type": "number"
                }
              }
            }
          }
        }
      ]
    }
  }
}
