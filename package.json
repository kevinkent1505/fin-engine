{
  "name": "fin-engine",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/api",
    "apps/dashboard"
  ],
  "scripts": {
    "setup": "node scripts/fin-engine.mjs setup",
    "dev": "node scripts/fin-engine.mjs dev",
    "dev:analysis": "node scripts/fin-engine.mjs analysis",
    "dev:api": "node scripts/fin-engine.mjs api",
    "build:api": "yarn workspace @fin-engine/api build",
    "typecheck:api": "yarn workspace @fin-engine/api typecheck",
    "dev:dashboard": "node scripts/fin-engine.mjs dashboard",
    "build:dashboard": "yarn workspace @fin-engine/dashboard build",
    "typecheck:dashboard": "yarn workspace @fin-engine/dashboard typecheck",
    "test:analysis": "node scripts/fin-engine.mjs test",
    "migrate": "node scripts/fin-engine.mjs migrate",
    "ingest": "node scripts/fin-engine.mjs ingest",
    "refresh:njkb": "node scripts/fin-engine.mjs refresh-njkb",
    "refresh:bps": "node scripts/fin-engine.mjs refresh-bps",
    "refresh:official": "node scripts/fin-engine.mjs refresh-official",
    "test:tooling": "node --check scripts/fin-engine.mjs && node --test scripts/tests/env-local.test.mjs",
    "setup:bps-browser": "node scripts/fin-engine.mjs setup-bps-browser",
    "env:check": "node scripts/fin-engine.mjs env-check",
    "import:riil-market": "node scripts/fin-engine.mjs import-riil-market"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8"
  }
}
