{
  "name": "fin-engine",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": ["apps/api", "apps/dashboard"],
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "dev:analysis": "cd apps/analysis && VEHICLE_DATA_PATH=${VEHICLE_DATA_PATH:-../../data/sample/vehicles.csv} uv run uvicorn riil_analysis.main:app --reload --host 0.0.0.0 --port 8001",
    "dev:api": "yarn workspace @fin-engine/api dev",
    "build:api": "yarn workspace @fin-engine/api build",
    "typecheck:api": "yarn workspace @fin-engine/api typecheck",
    "dev:dashboard": "yarn workspace @fin-engine/dashboard dev",
    "build:dashboard": "yarn workspace @fin-engine/dashboard build",
    "typecheck:dashboard": "yarn workspace @fin-engine/dashboard typecheck"
  }
}
